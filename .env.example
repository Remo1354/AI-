# ─────────────────────────────────────────────────────────────
# Remo AI Workspace 环境变量模板
# 用法：复制为 .env 后按需修改（bootstrap 脚本会自动复制）。
# .env 已被 .gitignore 忽略，绝不要把真实密钥提交到 Git。
# ─────────────────────────────────────────────────────────────

# ── 服务 ──────────────────────────────────────────────────────
# 监听地址。默认只允许本机访问；需要局域网/公网访问时改为 0.0.0.0，
# 此时必须同时设置 APP_PASSWORD，否则服务拒绝启动。
HOST=127.0.0.1
PORT=8787

# 数据目录（数据库、上传文件、密钥文件都在这里）。
# 可以指向任意持久化位置，例如 D:\RemoData 或 /mnt/data/remo
DATA_DIR=./data

# ── 安全 ──────────────────────────────────────────────────────
# 访问密码。留空 = 不需要登录（只允许在 HOST=127.0.0.1 的本机模式下留空）。
APP_PASSWORD=

# 只监听本机且未设密码时，默认只接受 localhost / 127.0.0.1 访问。
# 需要通过其他域名访问（例如开发预览地址）时在这里列出，逗号分隔；* 表示不限制。
ALLOWED_HOSTS=

# 用于加密数据库中 API Key 的主密钥。留空时首次启动会自动生成并保存到
# DATA_DIR/secret.key。迁移到新机器时，要么带上这个文件，要么重新填写 API Key。
APP_SECRET=

# ── AI 模型（可选）────────────────────────────────────────────
# 推荐在网页「设置 → 模型」里添加，密钥会加密保存在服务端数据库。
# 也可以在这里用环境变量提供，启动后会作为只读的模型来源出现。

# Anthropic Claude
ANTHROPIC_API_KEY=
# 逗号分隔的模型 ID；留空使用内置默认
ANTHROPIC_MODELS=

# 任意 OpenAI 兼容接口（OpenAI / DeepSeek / 通义千问 / Kimi / 智谱 / Ollama …）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=

# 单次回复的最大输出 token（仅对 Anthropic 生效；OpenAI 兼容接口默认不传）
AI_MAX_TOKENS=32000

# 附加资料注入对话时的字符预算（超过则改为检索相关片段）
AI_CONTEXT_CHARS=60000

# ── 自动备份 ──────────────────────────────────────────────────
# 每隔多少小时在 DATA_DIR/backups 里自动留一份完整备份；0 = 关闭。
# 服务器 / Docker 部署建议设为 24。备份可在「设置 → 数据与备份」下载。
AUTO_BACKUP_HOURS=0
# 保留最近多少份自动备份
AUTO_BACKUP_KEEP=7

# ── 上传 ──────────────────────────────────────────────────────
MAX_UPLOAD_MB=40
